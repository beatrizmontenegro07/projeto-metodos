# Mecanismo de armazenamento, escolhido na inicialização:
#   :memory:                  RAM — os dados somem quando o processo termina
#   file:local.db             SQLite permanente em arquivo local (desenvolvimento)
#   libsql://<banco>.turso.io Turso — SQLite hospedado (deploy na Vercel)
DATABASE_URL=file:local.db

# Obrigatório apenas para o Turso.
DATABASE_AUTH_TOKEN=
