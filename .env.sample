# Storage mechanism for users, chosen at startup:
#   memory   RAM collection — data is lost when the process exits
#   sqlite   SQLite database at DATABASE_URL
STORAGE=sqlite

# SQLite database, used when STORAGE=sqlite:
#   file:local.db                permanent SQLite file (local development)
#   libsql://<database>.turso.io Turso — hosted SQLite (Vercel deploy)
DATABASE_URL=file:local.db

# Required only for Turso.
DATABASE_AUTH_TOKEN=
