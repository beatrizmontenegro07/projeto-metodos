@startuml
skinparam classAttributeIconSize 0
hide empty methods
hide empty attributes
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

' Entidades Principais e Administrativas
class Clinica <<Organization>>
class Usuario {
  id: Number
  nome: String
  email: String
  login: String
  papel: Papel
  pacienteId: Number
  profissionalId: Number
}
class Papel <<enumeration>>
class Paciente <<Patient>> {
  id: Number
  cpf: String
  cns: String
  nomeCompleto: String
  dataNascimento: Date
  genero: String
  email: String
  ativo: Boolean
}
class Telefone <<ContactPoint>> {
  numero: String
  tipo: String
}
class Profissional <<Practitioner>> {
  id: Number
  nomeCompleto: String
  cpf: String
  conselho: String
  numeroRegistro: String
  ufRegistro: String
  ativo: Boolean
}
class Especialidade <<CodeableConcept>> {
  nome: String
  rqe: String
}
class VinculoProfissional <<PractitionerRole>> {
  id: Number
  profissionalId: Number
  clinicaId: Number
  papel: String
  ativo: Boolean
}

' Controle, validação, autenticação e persistência de usuários
class ControladorDeUsuarios <<control>> {
  +adicionar(nome, email, login, senha, papel): Usuario
  +autenticar(login, senha): Usuario
  +obterPorId(id): Usuario
  +listar(): Usuario[]
}
class ServicoDeTokenJwt <<service>> {
  +gerarTokenJwt(payload, opcoes): String
  +verificarTokenJwt(token, opcoes): Object
}
interface RepositorioDeUsuarios <<repository>> {
  +listar(): Usuario[]
  +salvar(usuario): void
}
class RepositorioEmMemoria <<repository>>
class RepositorioEmArquivoBinario <<repository>>
class FabricaDeRepositorioDeUsuarios <<factory>> {
  +criarRepositorioDeUsuarios(modo, arquivo): RepositorioDeUsuarios
}
class ErroDeValidacaoDeUsuario <<exception>>
class ErroDePersistenciaDeUsuarios <<exception>>
class ErroDeAutenticacao <<exception>>

' Controle e persistência de pacientes (UC01 / RF01)
class ControladorDePacientes <<control>> {
  +cadastrar(dados): Paciente
  +obterPorId(id): Paciente
  +atualizar(id, dados): Paciente
  +remover(id): void
  +listarPaginado(pagina, tamanhoPagina): PaginaDePacientes
}
interface RepositorioDePacientes <<repository>> {
  +listar(): Paciente[]
  +salvar(paciente): void
  +atualizar(paciente): void
  +remover(id): void
}
class RepositorioDePacientesEmMemoria <<repository>>
class RepositorioDePacientesEmArquivoBinario <<repository>>
class ErroDeValidacaoDePaciente <<exception>>
class ErroDePacienteNaoEncontrado <<exception>>
class ErroDePacienteDuplicado <<exception>>

' Entidades de Agendamento (Módulo Ambulatorial)
class Agenda <<Schedule>>
class HorarioDisponivel <<Slot>>
class Agendamento <<Appointment>>

' Entidades de Relacionamento (CRM)
class RegistroComunicacao <<Communication>>

' Entidades Clínicas Básicas
class Atendimento <<Encounter>>
class AnotacaoClinica <<Observation>>
class Diagnostico <<Condition>>

' Relacionamentos Estruturais
Clinica "1" -down- "*" Paciente : gerencia >
Clinica "1" -right- "*" VinculoProfissional : possui >
Profissional "1" -left- "*" VinculoProfissional : atua como >
Clinica "1" -left- "*" Usuario : possui >
Usuario --> Papel
Usuario "0..1" ..> "0..1" Paciente : vincula >
Usuario "0..1" ..> "0..1" Profissional : vincula >
Paciente "1" *-down- "*" Telefone : possui >
Profissional "*" -down- "*" Especialidade : possui >
VinculoProfissional "*" --> "*" Especialidade : atende >

' Validação, autenticação e persistência
ControladorDeUsuarios --> Usuario : cria/autentica/lista >
ControladorDeUsuarios --> RepositorioDeUsuarios : usa >
ControladorDeUsuarios ..> ErroDeValidacaoDeUsuario : lança >
ControladorDeUsuarios ..> ErroDeAutenticacao : lança >
ServicoDeTokenJwt ..> ErroDeAutenticacao : lança >
RepositorioDeUsuarios <|.. RepositorioEmMemoria
RepositorioDeUsuarios <|.. RepositorioEmArquivoBinario
RepositorioEmArquivoBinario ..> ErroDePersistenciaDeUsuarios : lança >
FabricaDeRepositorioDeUsuarios --> RepositorioDeUsuarios : seleciona >

' Gerenciamento de pacientes
ControladorDePacientes --> Paciente : cria/edita/remove/lista >
ControladorDePacientes --> RepositorioDePacientes : usa >
ControladorDePacientes ..> ErroDeValidacaoDePaciente : lança >
ControladorDePacientes ..> ErroDePacienteNaoEncontrado : lança >
ControladorDePacientes ..> ErroDePacienteDuplicado : lança >
RepositorioDePacientes <|.. RepositorioDePacientesEmMemoria
RepositorioDePacientes <|.. RepositorioDePacientesEmArquivoBinario

' Relacionamentos de CRM e Comunicação
Paciente "1" -left- "*" RegistroComunicacao : recebe/envia >

' Relacionamentos de Agendamento (Baseado na Grade Ambulatorial)
VinculoProfissional "1" -down- "*" Agenda : possui (grade) >
Agenda "1" *-down- "*" HorarioDisponivel : contem >
HorarioDisponivel "1" -right- "0..1" Agendamento : reservado para >
Agendamento "*" -up- "1" Paciente : pertence a >
Agendamento "*" -up- "1" VinculoProfissional : destinado a >

' Relacionamentos do Encontro Clínico
Agendamento "1" -down- "0..1" Atendimento : resulta em >
Atendimento "*" -up- "1" Paciente : sujeito >

' Relacionamentos de Desfecho Clínico
Atendimento "1" *-down- "*" AnotacaoClinica : gera >
Atendimento "1" *-down- "*" Diagnostico : identifica >

@enduml
