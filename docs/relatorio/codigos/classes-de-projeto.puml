@startuml classes-de-projeto
skinparam classAttributeIconSize 0
skinparam shadowing false
top to bottom direction
class "Telas / Server Actions / API" as UI <<boundary>>
class AccessReportsPage <<boundary>>
class AccessReportsHandler <<boundary>>
AccessReportsPage ..> AccessReportsHandler : solicita download
package business {
class FacadeSingletonController <<Facade, Singleton>> {
  -{static} instance: Promise<FacadeSingletonController>
  -FacadeSingletonController(repositories, logger)
  +{static} getInstance(loadRepositories, logger)
  +generateAccessReport(actor, input, labels)
  +signIn(credentials)
  +createFirstAdministrator(newUser)
  +addUser(actor, newUser)
  +listUsers(actor)
  +addPatient(actor, input)
  +updatePatient(actor, id, input)
  +getPatient(actor, id)
  +searchPatients(actor, search)
  +deactivatePatient(actor, id)
  +reactivatePatient(actor, id)
  +countRegisteredEntities(actor): RegisteredEntityCounts
  -authorize(actor, permission)
}
abstract class AccessReportTemplate <<Template Method>> {
  +generate(input, labels)
  -aggregate(records)
  #{abstract} render(statistics, labels)
}
class HtmlAccessReport
class CsvAccessReport
AccessReportTemplate <|-- HtmlAccessReport
AccessReportTemplate <|-- CsvAccessReport
AccessReportTemplate --> AccessRecordRepository
FacadeSingletonController ..> AccessReportTemplate : autoriza e gera
class RegisteredEntityCounts {
  users?: number
  patients?: number
}
class UserController {
  +add(newUser)
  +addFirstAdministrator(newUser)
  +hasUsers()
  +list()
  +findById(id)
  +count()
}
class AuthenticationController {
  +signIn(credentials)
}
class PatientController {
  +add(input, createdBy)
  +update(id, input)
  +get(id)
  +search(search)
  +deactivate(id)
  +reactivate(id)
  +count()
}
interface AccessRecordRepository <<Repository>> {
  +add(record): Promise<void>
  +list(): Promise<AccessRecord[]>
}
class AccessRecord <<entity>> {
  id: number
  userId: number
  occurredAt: string
}
AuthenticationController --> AccessRecordRepository : grava antes do log
AccessRecordRepository ..> AccessRecord
AccessRecord "*" --> "1" User
interface AccessLogger <<Target>> {
  +recordSignIn(userId)
}
interface UserRepository <<Repository>>
interface PatientRepository <<Repository>>
class User <<entity>>
class Patient <<entity>>
UserRepository ..> User : retorna
PatientRepository ..> Patient : retorna
Patient "*" --> "1" User : cadastrado por
}
package infra {
  class "infra/facade.ts" as Assembly {
    +getFacade()
  }
  interface RepositoryFactory <<Abstract Factory>> {
    +createUserRepository(): UserRepository
    +createPatientRepository(): PatientRepository
    +createAccessRecordRepository(): AccessRecordRepository
  }
  class InMemoryRepositoryFactory <<Concrete Factory>>
  class SqliteRepositoryFactory <<Concrete Factory>> {
    -database: Database
  }
  class "repository-factory.ts" as Selection {
    +createRepositoryFactory(mechanism): Promise<RepositoryFactory>
    +getRepositories(): Promise<Repositories>
  }
  class InMemoryUserRepository
  class SqliteUserRepository
  class InMemoryPatientRepository
  class SqlitePatientRepository
  class InMemoryAccessRecordRepository
  class SqliteAccessRecordRepository
  class Database
  class PinoAccessLogger <<Adapter>> {
    -logger: Logger
    +recordSignIn(userId)
  }
}
package pino {
  class Logger <<Adaptee>> {
    +info(object)
  }
}
Assembly ..> PinoAccessLogger : injeta pela fachada
AuthenticationController --> AccessLogger
AccessLogger <|.. PinoAccessLogger
PinoAccessLogger --> Logger : adapta para info
AccessRecordRepository <|.. InMemoryAccessRecordRepository
AccessRecordRepository <|.. SqliteAccessRecordRepository
