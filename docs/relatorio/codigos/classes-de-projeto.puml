@startuml classes-de-projeto
skinparam classAttributeIconSize 0
skinparam shadowing false
top to bottom direction
class "Telas / Server Actions / API" as UI <<boundary>>
package business {
class FacadeSingletonController <<Facade, Singleton>> {
  -{static} instance: Promise<FacadeSingletonController>
  -FacadeSingletonController(repositories)
  +{static} getInstance(loadRepositories)
  +signIn(credentials)
  +createFirstAdministrator(newUser)
  +addUser(actor, newUser)
  +listUsers(actor)
  +addPatient(actor, input)
  +updatePatient(actor, id, input)
  +getPatient(actor, id)
  +searchPatients(actor, search)
  +deactivatePatient(actor, id)
  +reactivatePatient(actor, id)
  +countRegisteredEntities(actor): RegisteredEntityCounts
  -authorize(actor, permission)
}
class RegisteredEntityCounts {
  users?: number
  patients?: number
}
class UserController {
  +add(newUser)
  +addFirstAdministrator(newUser)
  +hasUsers()
  +list()
  +findById(id)
  +count()
}
class AuthenticationController {
  +signIn(credentials)
}
class PatientController {
  +add(input, createdBy)
  +update(id, input)
  +get(id)
  +search(search)
  +deactivate(id)
  +reactivate(id)
  +count()
}
interface UserRepository <<Repository>>
interface PatientRepository <<Repository>>
class User <<entity>>
class Patient <<entity>>
UserRepository ..> User : retorna
PatientRepository ..> Patient : retorna
Patient "*" --> "1" User : cadastrado por
}
package infra {
  class "infra/facade.ts" as Assembly {
    +getFacade()
  }
  interface RepositoryFactory <<Abstract Factory>> {
    +createUserRepository(): UserRepository
    +createPatientRepository(): PatientRepository
  }
  class InMemoryRepositoryFactory <<Concrete Factory>>
  class SqliteRepositoryFactory <<Concrete Factory>> {
    -database: Database
  }
  class "repository-factory.ts" as Selection {
    +createRepositoryFactory(mechanism): Promise<RepositoryFactory>
    +getRepositories(): Promise<Repositories>
  }
  class InMemoryUserRepository
  class SqliteUserRepository
  class InMemoryPatientRepository
  class SqlitePatientRepository
  class Database
}
Assembly ..> Selection : getRepositories
Selection ..> RepositoryFactory : monta a família
Selection ..> InMemoryRepositoryFactory : STORAGE=memory
Selection ..> SqliteRepositoryFactory : STORAGE=sqlite
RepositoryFactory <|.. InMemoryRepositoryFactory
RepositoryFactory <|.. SqliteRepositoryFactory
InMemoryRepositoryFactory ..> InMemoryUserRepository : cria
InMemoryRepositoryFactory ..> InMemoryPatientRepository : cria
SqliteRepositoryFactory ..> SqliteUserRepository : cria
SqliteRepositoryFactory ..> SqlitePatientRepository : cria
SqliteRepositoryFactory --> Database : compartilha
SqliteUserRepository --> Database
SqlitePatientRepository --> Database
UserRepository <|.. InMemoryUserRepository
UserRepository <|.. SqliteUserRepository
PatientRepository <|.. InMemoryPatientRepository
PatientRepository <|.. SqlitePatientRepository
UI ..> Assembly
Assembly ..> FacadeSingletonController : getInstance
FacadeSingletonController *-- UserController
FacadeSingletonController *-- AuthenticationController
FacadeSingletonController *-- PatientController
FacadeSingletonController ..> RegisteredEntityCounts
UserController --> UserRepository
AuthenticationController --> UserRepository
PatientController --> PatientRepository
note bottom of FacadeSingletonController
Visão dos métodos principais da fachada.
Papéis são verificados nas operações protegidas.
end note
@enduml
