@startuml classes-de-projeto
skinparam classAttributeIconSize 0
skinparam shadowing false
top to bottom direction
class "Telas / Server Actions / API" as UI <<boundary>>
class AccessReportsPage <<boundary>>
class AccessReportsHandler <<boundary>>
AccessReportsPage ..> AccessReportsHandler : solicita download
package business {
class FacadeSingletonController <<Facade, Singleton, Client>> {
  -{static} instance: Promise<FacadeSingletonController>
  -invoker: CommandInvoker
  -patientUpdates: PatientUpdateHistory
  -FacadeSingletonController(repositories, logger)
  +{static} getInstance(loadRepositories, logger)
  +generateAccessReport(actor, input, labels)
  +signIn(credentials)
  +createFirstAdministrator(newUser)
  +addUser(actor, newUser)
  +listUsers(actor)
  +addPatient(actor, input)
  +updatePatient(actor, id, input)
  +undoPatientUpdate(actor, id)
  +canUndoPatientUpdate(actor, id)
  +getPatient(actor, id)
  +searchPatients(actor, search)
  +deactivatePatient(actor, id)
  +reactivatePatient(actor, id)
  +countRegisteredEntities(actor): RegisteredEntityCounts
  -authorize(actor, permission)
}
abstract class AccessReportTemplate <<Template Method>> {
  +generate(input, labels)
  -aggregate(records)
  #{abstract} render(statistics, labels)
}
class HtmlAccessReport
class CsvAccessReport
AccessReportTemplate <|-- HtmlAccessReport
AccessReportTemplate <|-- CsvAccessReport
AccessReportTemplate --> AccessRecordRepository
FacadeSingletonController ..> AccessReportTemplate : autoriza e gera (por comando)
class RegisteredEntityCounts {
  users?: number
  patients?: number
}
class UserController {
  +add(newUser)
  +addFirstAdministrator(newUser)
  +hasUsers()
  +list()
  +findById(id)
  +count()
}
class AuthenticationController {
  +signIn(credentials)
}
class PatientController {
  +add(input, createdBy)
  +update(id, input)
  +get(id)
  +search(search)
  +deactivate(id)
  +reactivate(id)
  +count()
  +createMemento(id): PatientMemento
  +restore(memento): Patient
}
package commands <<Command>> {
interface "Command<Result>" as Command <<Command>> {
  +execute(): Promise<Result>
}
class CommandInvoker <<Invoker>> {
  +execute(command: Command): Promise<Result>
}
class UpdatePatientCommand <<ConcreteCommand>> {
  -id: number
  -input: PatientInput
  +execute(): Promise<Patient>
}
class UndoPatientUpdateCommand <<ConcreteCommand>> {
  -id: number
  +execute(): Promise<Patient>
}
class CanUndoPatientUpdateCommand <<ConcreteCommand>>
class "AddPatientCommand\nGetPatientCommand\nSearchPatientsCommand\nDeactivatePatientCommand\nReactivatePatientCommand" as PatientCommands <<ConcreteCommand>>
class "SignInCommand\nFindUserCommand\nHasUsersCommand\nCreateFirstAdministratorCommand\nAddUserCommand\nListUsersCommand" as UserCommands <<ConcreteCommand>>
class "GenerateAccessReportCommand\nCountRegisteredEntitiesCommand" as ReportCommands <<ConcreteCommand>>
}
class PatientMemento <<Memento>> {
  +patientId: number
  -state: Readonly<PatientData>
  +getState(): Readonly<PatientData>
}
class PatientUpdateHistory <<Caretaker>> {
  -stacks: Map<number, PatientMemento[]>
  +push(memento)
  +peek(patientId)
  +pop(patientId)
  +has(patientId)
}
Command <|.. UpdatePatientCommand
Command <|.. UndoPatientUpdateCommand
Command <|.. CanUndoPatientUpdateCommand
Command <|.. PatientCommands
Command <|.. UserCommands
Command <|.. ReportCommands
CommandInvoker ..> Command : execute
FacadeSingletonController *-- CommandInvoker
FacadeSingletonController ..> Command : cria e entrega ao Invoker
FacadeSingletonController *-- PatientUpdateHistory
UpdatePatientCommand --> PatientController : Receiver e Originator
UndoPatientUpdateCommand --> PatientController : restore
PatientCommands --> PatientController : Receiver
UserCommands --> UserController : Receiver
UserCommands --> AuthenticationController : Receiver
ReportCommands --> AccessReportTemplate : Receiver
UpdatePatientCommand --> PatientUpdateHistory : push
UndoPatientUpdateCommand --> PatientUpdateHistory : peek e pop
CanUndoPatientUpdateCommand --> PatientUpdateHistory : has
PatientController ..> PatientMemento : cria e restaura
PatientUpdateHistory o-- "*" PatientMemento
interface AccessRecordRepository <<Repository>> {
  +add(record): Promise<void>
  +list(): Promise<AccessRecord[]>
}
class AccessRecord <<entity>> {
  id: number
  userId: number
  occurredAt: string
}
AuthenticationController --> AccessRecordRepository : grava antes do log
AccessRecordRepository ..> AccessRecord
AccessRecord "*" --> "1" User
interface AccessLogger <<Target>> {
  +recordSignIn(userId)
}
interface UserRepository <<Repository>>
interface PatientRepository <<Repository>>
class User <<entity>>
class Patient <<entity>>
UserRepository ..> User : retorna
PatientRepository ..> Patient : retorna
Patient "*" --> "1" User : cadastrado por
}
package infra {
  class "infra/facade.ts" as Assembly {
    +getFacade()
  }
  interface RepositoryFactory <<Abstract Factory>> {
    +createUserRepository(): UserRepository
    +createPatientRepository(): PatientRepository
    +createAccessRecordRepository(): AccessRecordRepository
  }
  class InMemoryRepositoryFactory <<Concrete Factory>>
  class SqliteRepositoryFactory <<Concrete Factory>> {
    -database: Database
  }
  class "repository-factory.ts" as Selection {
    +createRepositoryFactory(mechanism): Promise<RepositoryFactory>
    +getRepositories(): Promise<Repositories>
  }
  class InMemoryUserRepository
  class SqliteUserRepository
  class InMemoryPatientRepository
  class SqlitePatientRepository
  class InMemoryAccessRecordRepository
  class SqliteAccessRecordRepository
  class Database
  class PinoAccessLogger <<Adapter>> {
    -logger: Logger
    +recordSignIn(userId)
  }
}
package pino {
  class Logger <<Adaptee>> {
    +info(object)
  }
}
Assembly ..> PinoAccessLogger : injeta pela fachada
AuthenticationController --> AccessLogger
AccessLogger <|.. PinoAccessLogger
PinoAccessLogger --> Logger : adapta para info
AccessRecordRepository <|.. InMemoryAccessRecordRepository
AccessRecordRepository <|.. SqliteAccessRecordRepository
InMemoryRepositoryFactory ..> InMemoryAccessRecordRepository : cria
SqliteRepositoryFactory ..> SqliteAccessRecordRepository : cria
SqliteAccessRecordRepository --> Database
Assembly ..> Selection : getRepositories
Selection ..> RepositoryFactory : monta a família
Selection ..> InMemoryRepositoryFactory : STORAGE=memory
Selection ..> SqliteRepositoryFactory : STORAGE=sqlite
RepositoryFactory <|.. InMemoryRepositoryFactory
RepositoryFactory <|.. SqliteRepositoryFactory
InMemoryRepositoryFactory ..> InMemoryUserRepository : cria
InMemoryRepositoryFactory ..> InMemoryPatientRepository : cria
SqliteRepositoryFactory ..> SqliteUserRepository : cria
SqliteRepositoryFactory ..> SqlitePatientRepository : cria
SqliteRepositoryFactory --> Database : compartilha
SqliteUserRepository --> Database
SqlitePatientRepository --> Database
UserRepository <|.. InMemoryUserRepository
UserRepository <|.. SqliteUserRepository
PatientRepository <|.. InMemoryPatientRepository
PatientRepository <|.. SqlitePatientRepository
UI ..> Assembly
Assembly ..> FacadeSingletonController : getInstance
FacadeSingletonController *-- UserController
FacadeSingletonController *-- AuthenticationController
FacadeSingletonController *-- PatientController
FacadeSingletonController ..> RegisteredEntityCounts
UserController --> UserRepository
AuthenticationController --> UserRepository
PatientController --> PatientRepository
note bottom of FacadeSingletonController
Visão dos métodos principais da fachada.
Papéis são verificados nas operações protegidas.
Cada método cria um ConcreteCommand e o executa pelo CommandInvoker.
end note
AccessReportsHandler ..> business.FacadeSingletonController : generateAccessReport
