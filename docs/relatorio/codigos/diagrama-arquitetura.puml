@startuml diagrama-arquitetura
skinparam componentStyle rectangle
skinparam shadowing false
actor "Usuário no navegador" as Browser
node "Aplicativo Next.js / TypeScript" {
  package "ui — app, components, i18n" {
    component "Páginas e Server Actions" as Pages
    component "Route handlers /api" as API
  }
  component "infra/facade.ts\ngetFacade()" as Assembly
  package "business — modules" {
    component "FacadeSingletonController\nFacade + Singleton + autorização" as Facade
    component "UserController\nAuthenticationController\nPatientController" as Controllers
    component "AccessReportTemplate\nHtmlAccessReport / CsvAccessReport\nTemplate Method" as Reports
    component "<<interface>>\nUserRepository / PatientRepository\nAccessRecordRepository" as Ports
    component "<<interface>>\nAccessLogger (Target)" as LoggerPort
  }
  package "infra — infra, db" {
    component "Sessão em cookie assinado" as Session
    component "RepositoryFactory\nAbstract Factory" as Factory
    component "PinoAccessLogger\nAdapter" as Pino
    component "Coleções em RAM" as RAM
    component "Repositórios SQLite\nDrizzle ORM / libSQL" as SQL
  }
}
database "SQLite local ou Turso" as DB
Browser --> Pages
Browser --> API
Pages --> Assembly
API --> Assembly
Pages ..> Session
API ..> Session
Assembly --> Facade
Assembly ..> Factory : getRepositories
Factory ..> RAM : STORAGE=memory
Factory ..> SQL : STORAGE=sqlite
Assembly ..> Pino : injeta
Facade --> Reports
Reports --> Ports
Controllers --> LoggerPort
Pino ..|> LoggerPort
Facade --> Controllers
Controllers --> Ports
RAM ..|> Ports
SQL ..|> Ports
SQL --> DB
note bottom of Facade
Dependências: ui -> business <- infra.
Agenda, atendimento, mensagens e FHIR planejados.
end note
@enduml
