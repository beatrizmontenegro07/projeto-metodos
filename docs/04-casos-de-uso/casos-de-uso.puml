rectangle CliniCore {
  usecase "UC04 Autenticar" as UC04
  usecase "UC05 Cadastrar usuário" as UC05
  usecase "UC06 Listar usuários" as UC06
  usecase "UC12 Gerenciar profissionais\ne clínica" as UC12
  usecase "UC01 Cadastrar paciente" as UC01
  usecase "UC07 Editar paciente" as UC07
  usecase "UC08 Inativar e reativar\npaciente" as UC08
  usecase "UC09 Buscar pacientes" as UC09
  usecase "UC10 Consultar totais\ncadastrados" as UC10
  usecase "UC02 Agendar consulta" as UC02
  usecase "UC11 Reagendar consulta" as UC11
  usecase "UC13 Gerenciar comunicações\ne lembretes" as UC13
  usecase "UC03 Registrar atendimento" as UC03
  usecase "UC14 Exportar paciente\nem FHIR" as UC14
}

Administrador --> UC05
Administrador --> UC06
Administrador --> UC12
Administrador --> UC01
Administrador --> UC07
Administrador --> UC08
Administrador --> UC09
Administrador --> UC10
Recepcionista --> UC01
Recepcionista --> UC07
Recepcionista --> UC08
Recepcionista --> UC09
Recepcionista --> UC10
Recepcionista --> UC02
Paciente --> UC02
Medico --> UC03
Administrador --> UC04
Recepcionista --> UC04
Medico --> UC04
Paciente --> UC04

UC11 ..> UC02 : <<extend>>
UC02 ..> UC13 : <<include>>
UC13 --> Mensagens
UC14 --> SistemaExterno

