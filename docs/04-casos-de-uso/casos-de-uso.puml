@startuml casos-de-uso
left to right direction
skinparam packageStyle rectangle

actor Administrador
actor Recepcionista
actor "Médico" as Medico
actor Paciente

rectangle CliniCore {
  usecase "UC04 Autenticar" as UC04
  usecase "UC05 Cadastrar usuário" as UC05
  usecase "UC06 Listar usuários" as UC06
}

Administrador --> UC05
Administrador --> UC06
Administrador --> UC04
Recepcionista --> UC04
Medico --> UC04
Paciente --> UC04
UC05 ..> UC04 : <<include>>
UC06 ..> UC04 : <<include>>
@enduml
